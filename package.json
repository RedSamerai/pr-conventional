{
  "name": "pr-conventional",
  "version": "0.3.0",
  "private": true,
  "description": "Enforce & auto-fix Conventional Commits, PR titles & descriptions",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "generate-schema": "node scripts/generate-schema.mjs",
    "validate-schema": "node scripts/validate-schema.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.0",
    "simple-git": "^3.22.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vercel/ncc": "^0.38.0",
    "eslint": "^8.56.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
