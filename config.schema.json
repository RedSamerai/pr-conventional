{
  "$id": "pr-conventional.config.schema.json",
  "$ref": "#/definitions/Config",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Config": {
      "additionalProperties": false,
      "properties": {
        "customRules": {
          "items": {
            "$ref": "#/definitions/CustomRule"
          },
          "type": "array"
        },
        "extends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "继承远程或本地规则包。\n- 接受单个 URL 字符串或字符串数组\n- 仅支持 http(s) URL（避免供应链风险，不支持本地相对路径）\n- 加载失败时静默回退到内置默认规则"
        },
        "fixMode": {
          "type": "boolean"
        },
        "monorepo": {
          "$ref": "#/definitions/MonorepoConfig"
        },
        "rules": {
          "additionalProperties": false,
          "properties": {
            "commit-message": {
              "$ref": "#/definitions/RuleConfig"
            },
            "pr-body": {
              "$ref": "#/definitions/RuleConfig"
            },
            "pr-title": {
              "$ref": "#/definitions/RuleConfig"
            }
          },
          "required": [
            "commit-message",
            "pr-title"
          ],
          "type": "object"
        }
      },
      "required": [
        "rules"
      ],
      "type": "object"
    },
    "CustomRule": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "error",
            "warning"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "targets": {
          "items": {
            "enum": [
              "commit-message",
              "pr-title",
              "pr-body"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "pattern",
        "message",
        "level",
        "targets"
      ],
      "type": "object"
    },
    "MonorepoConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "packages": {
          "items": {
            "$ref": "#/definitions/MonorepoPackage"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "MonorepoPackage": {
      "additionalProperties": false,
      "description": "monorepo 按包路由（v0.2.0）。 每个 commit 按它改动的文件归属到 path 前缀，命中包用「根 config.rules['commit-message'] + package.rules」deepMerge 后的规则集校验；触及多个包时各校验一次（最严语义）。 无归属 / merge commit / 浅克隆读不到改动文件 → 回退根配置。 PR 标题/正文不路由（整 PR 级别），走根配置（v0.3 再做）。\n\n注意：packages[].rules 是 Partial<RuleConfig>（直接挂 types/scopeRegex 等字段）， 不要再套一层 'commit-message'。",
      "properties": {
        "path": {
          "description": "目录前缀，如 \"packages/frontend\"；匹配时按「改动文件落在该前缀下」判断",
          "type": "string"
        },
        "rules": {
          "additionalProperties": false,
          "description": "该包的 commit-message 规则覆盖（与根 commit-message 规则 deepMerge）",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxLength": {
              "type": "number"
            },
            "pattern": {
              "type": "string"
            },
            "requiredSections": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "scopeRegex": {
              "type": "string"
            },
            "subjectMaxLength": {
              "type": "number"
            },
            "template": {
              "type": "string"
            },
            "types": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "RuleConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxLength": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        },
        "requiredSections": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scopeRegex": {
          "type": "string"
        },
        "subjectMaxLength": {
          "type": "number"
        },
        "template": {
          "type": "string"
        },
        "types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    }
  }
}

